{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAccountsOnly",
      "Effect": "Allow",
      "Action": ["cognito-idp:ListUsers", "cognito-idp:ListUsersInGroup"],
      "Resource": "arn:aws:cognito-idp:us-east-1:000000000000:userpool/USER_POOL_ID"
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/admin-*"
    }
  ]
}
