{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnTableOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/CheckIns",
        "arn:aws:dynamodb:us-east-1:000000000000:table/CheckIns/index/krId-createdAt-index",
        "arn:aws:dynamodb:us-east-1:000000000000:table/CheckIns/index/userId-createdAt-index"
      ]
    },
    {
      "Sid": "PublishCheckInEvents",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:okr-events"
    },
    {
      "Sid": "AskKeyResultsAndGoalsForC1",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:000000000000:function:kr-internal",
        "arn:aws:lambda:us-east-1:000000000000:function:goals-internal"
      ]
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/checkins-*"
    }
  ]
}
